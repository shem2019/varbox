-                fighter1_score += 1
-                time_stamp = f"{frame_count // frame_rate:02}:{frame_count % frame_rate:02}"
-                punch_log.append(("Fighter 1", time_stamp, fighter1_score))
-                f1_last_punch = frame_count
-
-        # Fighter 2 Punch Detection (mirror)
